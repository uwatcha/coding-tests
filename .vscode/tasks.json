{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile current C# file with Mono debug symbols",
            "type": "shell",
            "command": "mcs",
            "args": [
                "-debug",
                "-define:DEBUG",
                "-out:${fileDirname}/${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            // ビルド結果は問題フォルダに置かず .build/ の下にまとめる
            "label": "Compile current C++ file with debug symbols",
            "type": "shell",
            "command": "mkdir -p '${workspaceFolder}/.build/${relativeFileDirname}' && clang++ -std=c++20 -g -O0 -Wall -DDEBUG -I'${workspaceFolder}/include' -o '${workspaceFolder}/.build/${relativeFileDirname}/${fileBasenameNoExtension}.out' '${file}'",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": "$gcc"
        }
    ]
}
